# Connection details for this project's databases on the SHARED Postgres server —
# dev + prod, the default. One ExternalSecret per namespace, each pointing at
# that environment's own database and role.
#
# The databases and roles themselves are infra-owned and live in
# k8s/infra-manifest/postgres/databases/ — CNPG's Database/DatabaseRole must sit
# in the shared cluster's namespace (spec.cluster takes a name, not a namespace).
# This file only materializes the credentials into the project's namespaces.
#
# Prereqs (see docs/onboarding.md → "Add a database"):
#   - infra has committed k8s/infra-manifest/postgres/databases/proj-wsj27.yaml
#   - both passwords are in Key Vault as postgres-proj-wsj27-dev-password and
#     postgres-proj-wsj27-prod-password
#
# ONE environment only? Delete the prod block and drop the `-dev` suffix in what
# remains (and do the same on the infra side). ADDING staging? Copy a block.
#
# A project that needs its OWN Postgres instance instead (heavy load, a
# different major version, an extension the shared server does not carry) can
# create a CNPG Cluster in this namespace — see docs/postgres.md.
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: proj-wsj27-db
  namespace: proj-wsj27-dev
spec:
  refreshInterval: 24h
  secretStoreRef:
    name: azure-kv
    kind: ClusterSecretStore
  target:
    name: proj-wsj27-db
    template:
      type: Opaque
      data:
        # Individual fields, plus a ready-made URL for libraries that want one.
        # The password lands in `uri` UNENCODED: generate it alphanumeric-only,
        # or a reserved character (@ : / % #) breaks the URI while the
        # individual fields still work.
        host: shared-rw.postgres.svc.cluster.local
        port: "5432"
        dbname: proj-wsj27-dev
        username: proj-wsj27-dev
        password: "{{ .password }}"
        uri: "postgresql://proj-wsj27-dev:{{ .password }}@shared-rw.postgres.svc.cluster.local:5432/proj-wsj27-dev"
  data:
    - secretKey: password
      remoteRef:
        key: postgres-proj-wsj27-dev-password
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: proj-wsj27-db
  namespace: proj-wsj27-prod
spec:
  refreshInterval: 24h
  secretStoreRef:
    name: azure-kv
    kind: ClusterSecretStore
  target:
    name: proj-wsj27-db
    template:
      type: Opaque
      data:
        host: shared-rw.postgres.svc.cluster.local
        port: "5432"
        dbname: proj-wsj27-prod
        username: proj-wsj27-prod
        password: "{{ .password }}"
        uri: "postgresql://proj-wsj27-prod:{{ .password }}@shared-rw.postgres.svc.cluster.local:5432/proj-wsj27-prod"
  data:
    - secretKey: password
      remoteRef:
        key: postgres-proj-wsj27-prod-password
